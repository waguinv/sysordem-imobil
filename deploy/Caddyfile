# HTTPS automático (Let's Encrypt). WEB_DOMAIN e API_DOMAIN vêm do .env do servidor.
{$WEB_DOMAIN} {
	encode zstd gzip
	reverse_proxy web:3000
}

# A API pública só recebe webhooks dos provedores e o /health; o restante é acessado pelo web (BFF).
{$API_DOMAIN} {
	@public path /api/v1/webhooks/* /health
	handle @public {
		reverse_proxy api:8000
	}
	respond 404
}
