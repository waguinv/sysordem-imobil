# Copie para .env e troque TODOS os valores CHANGE_ME por segredos longos e aleatórios.
POSTGRES_DB=imobil
# Dono das tabelas (migrations). A aplicação NÃO usa este papel.
POSTGRES_USER=imobil_owner
POSTGRES_PASSWORD=CHANGE_ME_OWNER_PASSWORD
# Papel da aplicação (sem superuser/BYPASSRLS — sujeito ao RLS)
APP_DB_ROLE=imobil_app
APP_DB_PASSWORD=CHANGE_ME_APP_PASSWORD
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE_ME_JWT_SECRET_MIN_32_CHARS
ACCESS_TOKEN_MINUTES=60
# Pagamentos (Fase 4a): segredo HMAC dos webhooks do PSP sandbox (>= 32 caracteres).
# O sandbox fica desligado em produção (e não pode ser forçado lá).
PAYMENTS_SANDBOX_SECRET=CHANGE_ME_SANDBOX_WEBHOOK_SECRET_MIN_32_CHARS
# PSP real: Asaas (docs/PAGAMENTOS_ASAAS.md)
# Cofre das chaves de API das empresas (AES-256-GCM). Gere com: openssl rand -base64 32
# Guarde uma cópia fora do servidor: sem ela as contas Asaas das empresas precisam ser religadas.
PAYMENTS_CREDENTIALS_KEY=
# URL pública da API (registro automático do webhook na conta Asaas de cada empresa)
PUBLIC_API_URL=
# Endereço do sistema (links dos e-mails de senha e convite), ex.: https://imobil.suaempresa.com.br
PUBLIC_WEB_URL=
# Conta Asaas da PLATAFORMA (assinatura SaaS). Token do webhook: 32+ caracteres aleatórios
# A chave começa com $ — use ASPAS SIMPLES, senão o docker compose a lê como variável e entrega vazia:
# BILLING_ASAAS_API_KEY='$aact_prod_...'
BILLING_ASAAS_API_KEY=
BILLING_ASAAS_ENVIRONMENT=sandbox
BILLING_ASAAS_WEBHOOK_TOKEN=
# Assinatura eletrônica (opcional) — Documenso auto-hospedado. Ver docs/ASSINATURA_ELETRONICA.md.
# Vazio = só o simulador (fora de produção). Suba com: docker compose --profile assinatura up
DOCUMENSO_URL=
DOCUMENSO_API_TOKEN=
# Mesmo valor configurado no webhook do Documenso (>= 32 caracteres)
DOCUMENSO_WEBHOOK_SECRET=
DOCUMENSO_PUBLIC_URL=http://localhost:3005
DOCUMENSO_DB_PASSWORD=CHANGE_ME_DOCUMENSO_DB_PASSWORD
DOCUMENSO_NEXTAUTH_SECRET=CHANGE_ME_DOCUMENSO_NEXTAUTH_SECRET
DOCUMENSO_ENCRYPTION_KEY=CHANGE_ME_DOCUMENSO_ENCRYPTION_KEY_32_CHARS
DOCUMENSO_ENCRYPTION_SECONDARY_KEY=CHANGE_ME_DOCUMENSO_SECONDARY_KEY_32_CHARS
DOCUMENSO_SIGNING_PASSPHRASE=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
API_PORT=8000
WEB_PORT=3000
# development | staging | production (produção recusa subir com valores de desenvolvimento)
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:3000"]
# json (padrão em staging/produção) ou text
LOG_FORMAT=
# De quem a API aceita X-Forwarded-For (no deploy: "*", pois a API só escuta em 127.0.0.1 atrás do nginx)
FORWARDED_ALLOW_IPS=127.0.0.1
# Pool de conexões por processo (some todos os processos e confira max_connections do PostgreSQL)
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
# Workers do uvicorn (limites de tentativa em memória passam a valer por worker)
WEB_CONCURRENCY=1

# --- Deploy (staging/produção) — ver docs/CI_CD.md ---
# (IMAGE_TAG não vai aqui: o deploy/deploy.sh define a cada implantação)
GHCR_OWNER=waguinv
# Nome do projeto no Docker (separa containers e o volume do banco de cada ambiente no mesmo servidor)
# produção: sysordem-imobil | staging: sysordem-imobil-staging
#COMPOSE_PROJECT_NAME=
# Portas internas (só 127.0.0.1) que o nginx do servidor usa — produção 3710/8710, staging 3720/8720
WEB_HOST_PORT=
API_HOST_PORT=
# Backups criptografados: arquivo com a senha (chmod 600, fora do Git e da pasta de backups)
BACKUP_KEY_FILE=
BACKUP_DIR=./backups
BACKUP_KEEP_DAYS=14
# Cópia fora do servidor (deploy/offsite_backup.sh): destino rclone, ex. r2:sysordem-backups/producao
BACKUP_RCLONE_REMOTE=
# Monitor do backup diário (ex.: healthchecks.io): avisa sucesso e falha; alerta se o aviso não chegar
BACKUP_HEALTHCHECK_URL=
