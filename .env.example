# Copie para .env e troque TODOS os valores CHANGE_ME por segredos longos e aleatórios.
POSTGRES_DB=imobil
# Dono das tabelas (migrations). A aplicação NÃO usa este papel.
POSTGRES_USER=imobil_owner
POSTGRES_PASSWORD=CHANGE_ME_OWNER_PASSWORD
# Papel da aplicação (sem superuser/BYPASSRLS — sujeito ao RLS)
APP_DB_ROLE=imobil_app
APP_DB_PASSWORD=CHANGE_ME_APP_PASSWORD
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE_ME_JWT_SECRET_MIN_32_CHARS
ACCESS_TOKEN_MINUTES=60
API_PORT=8000
WEB_PORT=3000
ENVIRONMENT=development
